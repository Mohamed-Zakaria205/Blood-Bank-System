# ═══════════════════════════════════════════════════════════
# BloodLink — Production Environment Variables
# ═══════════════════════════════════════════════════════════
# API base URL — Vercel rewrites proxy /api/* to the real backend
VITE_API_URL=/api/v1/system
# Keep mock data for non-auth endpoints until backend is fully ready
VITE_USE_MOCK=true
# Auth always uses the real backend
VITE_USE_REAL_AUTH=true
